.vscode/
.idea/
Thumbs.db
desktop.ini

# Secrets and local configuration (never commit real values)
.env
.env.local
*.pem
*.key
id_rsa
id_rsa.pub
credentials.json

# Local databases and generated reports
*.db
*.db-wal
*.db-shm
